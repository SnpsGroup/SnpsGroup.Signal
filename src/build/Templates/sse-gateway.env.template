ASPNETCORE_ENVIRONMENT={{ENVIRONMENT_CAPITALIZED}}
ASPNETCORE_URLS=http://+:{{API_PORT}}
SseGateway__RedisConnectionString={{REDIS_CONNECTION_STRING}}
SseGateway__Keycloak__Url={{KEYCLOAK_URL}}
SseGateway__Keycloak__Realm={{KEYCLOAK_REALM}}
SseGateway__Keycloak__ClientId={{KEYCLOAK_CLIENT_ID}}
# Explicit issuer so tokens minted for the public hostname (https://auth.snpsgroup.com)
# validate even when keycloak-url is an internal Docker hostname (http://shared-keycloak).
# When empty, the gateway derives it from keycloak-url + realm (see Build.Deploy.cs).
SseGateway__Keycloak__ValidIssuer={{KEYCLOAK_VALID_ISSUER}}
SseGateway__Keycloak__RequireHttpsMetadata=true
Serilog__MinimumLevel__Default={{LOG_LEVEL}}
APP_VERSION={{IMAGE_VERSION}}
